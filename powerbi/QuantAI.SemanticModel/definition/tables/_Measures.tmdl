	measure 'QA Actual Value' =
			VAR cid = SELECTEDVALUE ( qa_expected[check_id] )
			RETURN
			    SWITCH (
			        cid,
			        "rowcount_dim_date", CALCULATE ( COUNTROWS ( dim_date ), REMOVEFILTERS () ),
			        "rowcount_dim_symbol", CALCULATE ( COUNTROWS ( dim_symbol ), REMOVEFILTERS () ),
			        "rowcount_fact_prices", CALCULATE ( COUNTROWS ( fact_prices ), REMOVEFILTERS () ),
			        "rowcount_fact_signals", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS () ),
			        "rowcount_fact_news", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS () ),
			        "rowcount_fact_event_odds", CALCULATE ( COUNTROWS ( fact_event_odds ), REMOVEFILTERS () ),
			        "rowcount_fact_backtest_equity", CALCULATE ( COUNTROWS ( fact_backtest_equity ), REMOVEFILTERS () ),
			        "rowcount_fact_backtest_results", CALCULATE ( COUNTROWS ( fact_backtest_results ), REMOVEFILTERS () ),
			        "rowcount_fact_positions", CALCULATE ( COUNTROWS ( fact_positions ), REMOVEFILTERS () ),
			        "spy_vol20_2026-07-21", CALCULATE ( [Rolling Vol 20D (Ann)], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 21 ) ),
			        "spy_vol20_2026-07-22", CALCULATE ( [Rolling Vol 20D (Ann)], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 22 ) ),
			        "spy_vol20_2026-07-23", CALCULATE ( [Rolling Vol 20D (Ann)], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 23 ) ),
			        "spy_vol20_2026-07-24", CALCULATE ( [Rolling Vol 20D (Ann)], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 24 ) ),
			        "spy_vol20_2026-07-27", CALCULATE ( [Rolling Vol 20D (Ann)], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "spy_ma20_2026-07-21", CALCULATE ( [MA 20], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 21 ) ),
			        "spy_ma20_2026-07-22", CALCULATE ( [MA 20], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 22 ) ),
			        "spy_ma20_2026-07-23", CALCULATE ( [MA 20], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 23 ) ),
			        "spy_ma20_2026-07-24", CALCULATE ( [MA 20], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 24 ) ),
			        "spy_ma20_2026-07-27", CALCULATE ( [MA 20], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "spy_ma50_2026-07-21", CALCULATE ( [MA 50], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 21 ) ),
			        "spy_ma50_2026-07-22", CALCULATE ( [MA 50], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 22 ) ),
			        "spy_ma50_2026-07-23", CALCULATE ( [MA 50], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 23 ) ),
			        "spy_ma50_2026-07-24", CALCULATE ( [MA 50], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 24 ) ),
			        "spy_ma50_2026-07-27", CALCULATE ( [MA 50], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "spy_ma200_2026-07-21", CALCULATE ( [MA 200], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 21 ) ),
			        "spy_ma200_2026-07-22", CALCULATE ( [MA 200], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 22 ) ),
			        "spy_ma200_2026-07-23", CALCULATE ( [MA 200], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 23 ) ),
			        "spy_ma200_2026-07-24", CALCULATE ( [MA 200], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 24 ) ),
			        "spy_ma200_2026-07-27", CALCULATE ( [MA 200], REMOVEFILTERS (), dim_symbol[symbol] = "SPY", dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "spy_indexed_end",
			            VAR b = CALCULATE ( AVERAGE ( fact_prices[close] ), REMOVEFILTERS (), fact_prices[symbol] = "SPY", fact_prices[date] = DATE ( 2024, 7, 29 ) )
			            VAR c = CALCULATE ( AVERAGE ( fact_prices[close] ), REMOVEFILTERS (), fact_prices[symbol] = "SPY", fact_prices[date] = DATE ( 2026, 7, 27 ) )
			            RETURN DIVIDE ( c, b ) * 100,
			        "equity_indexed_end",
			            VAR b2 = CALCULATE ( AVERAGE ( fact_backtest_equity[equity] ), REMOVEFILTERS (), fact_backtest_equity[date] = DATE ( 2024, 7, 29 ) )
			            VAR c2 = CALCULATE ( AVERAGE ( fact_backtest_equity[equity] ), REMOVEFILTERS (), fact_backtest_equity[date] = DATE ( 2026, 7, 27 ) )
			            RETURN DIVIDE ( c2, b2 ) * 100,
			        "bt_total_return", [Total Return],
			        "bt_cagr", [CAGR],
			        "bt_annual_volatility", [Annual Volatility],
			        "bt_sharpe", [Sharpe],
			        "bt_max_drawdown", [Max Drawdown],
			        "bt_win_rate", [Win Rate],
			        "bt_total_turnover", MAX ( fact_backtest_results[total_turnover] ),
			        "pos_market_value", [Market Value],
			        "pos_cost_value", [Cost Value],
			        "pos_unrealized_pnl", [Unrealized PnL],
			        "pos_unrealized_pnl_pct", [Unrealized PnL %],
			        "sig_strong_short", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS (), fact_signals[signal_strength] = "strong_short" ),
			        "sig_strong_long", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS (), fact_signals[signal_strength] = "strong_long" ),
			        "sig_weak_short", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS (), fact_signals[signal_strength] = "weak_short" ),
			        "sig_weak_long", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS (), fact_signals[signal_strength] = "weak_long" ),
			        "sig_neutral", CALCULATE ( COUNTROWS ( fact_signals ), REMOVEFILTERS (), fact_signals[signal_strength] = "neutral" ),
			        "news_total", CALCULATE ( [News Count], REMOVEFILTERS () ),
			        "news_scored", CALCULATE ( [Scored News], REMOVEFILTERS () ),
			        "news_coverage", CALCULATE ( [Scored Coverage %], REMOVEFILTERS () ),
			        "encoding_curly_quote_rows",
			            CALCULATE ( COUNTROWS ( FILTER ( fact_event_odds, CONTAINSSTRING ( fact_event_odds[event_title], UNICHAR ( 8217 ) ) ) ), REMOVEFILTERS () ),
			        "rel_prices_20260727", CALCULATE ( COUNTROWS ( fact_prices ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "rel_composite_AAPL_202411", CALCULATE ( [Composite Signal], REMOVEFILTERS (), dim_date[year_month] = "2024-11", dim_symbol[symbol] = "AAPL" ),
			        "rel_composite_CRM_202411", CALCULATE ( [Composite Signal], REMOVEFILTERS (), dim_date[year_month] = "2024-11", dim_symbol[symbol] = "CRM" ),
			        "rel_composite_DRAM_202411", CALCULATE ( [Composite Signal], REMOVEFILTERS (), dim_date[year_month] = "2024-11", dim_symbol[symbol] = "DRAM" ),
			        "rel_news_2026-07-24", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 24 ) ),
			        "rel_news_2026-07-25", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 25 ) ),
			        "rel_news_2026-07-26", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 26 ) ),
			        "rel_odds_20260715", CALCULATE ( COUNTROWS ( fact_event_odds ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 15 ) ),
			        "rel_positions_20260727", CALCULATE ( COUNTROWS ( fact_positions ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "rel_equity_20260727", CALCULATE ( COUNTROWS ( fact_backtest_equity ), REMOVEFILTERS (), dim_date[date] = DATE ( 2026, 7, 27 ) ),
			        "rel_news_SPY", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), dim_symbol[symbol] = "SPY" ),
			        "rel_news_untagged", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), dim_symbol[symbol] = "(untagged)" ),
			        "dim_symbol_noblank", CALCULATE ( DISTINCTCOUNTNOBLANK ( dim_symbol[symbol] ), REMOVEFILTERS () ),
			        "blank_member_canary", CALCULATE ( COUNTROWS ( fact_news ), REMOVEFILTERS (), ISBLANK ( dim_symbol[symbol] ) ),
			        BLANK ()
			    )
		displayFolder: QA
		lineageTag: ec5c3a20-5445-48a0-a0e7-88f16f321f2c

	measure 'QA Status' =
			VAR cid = SELECTEDVALUE ( qa_expected[check_id] )
			VAR expT = SELECTEDVALUE ( qa_expected[expected] )
			RETURN
			    SWITCH (
			        TRUE (),
			        cid = "rowcount_fact_trades", "SKIPPED — not loaded by design (source has 0 rows)",
			        cid = "pos_latest_as_of",
			            IF ( FORMAT ( [Latest As Of], "yyyy-MM-dd" ) = expT, "PASS", "FAIL" ),
			        expT = "BLANK",
			            IF ( ISBLANK ( [QA Actual Value] ), "PASS", "FAIL — expected BLANK, got a value" ),
			        ISBLANK ( [QA Actual Value] ), "FAIL — actual is blank",
			        ABS ( [QA Actual Value] - VALUE ( expT ) )
			            <= 0.000001 * MAX ( ABS ( VALUE ( expT ) ), 0.000001 ), "PASS",
			        "FAIL"
			    )
		displayFolder: QA
		lineageTag: bb808063-2e5a-4ebf-ab2d-a22891398a8b

	measure 'QA Actual (display)' =
			VAR cid = SELECTEDVALUE ( qa_expected[check_id] )
			RETURN
			    IF ( cid = "pos_latest_as_of",
			         FORMAT ( [Latest As Of], "yyyy-MM-dd" ),
			         FORMAT ( [QA Actual Value], "0.##########" ) )
		displayFolder: QA
		lineageTag: ce30aa86-0b4f-4e30-90d8-75247340d0e3

	measure 'QA Pass Count' = SUMX ( VALUES ( qa_expected[check_id] ), IF ( [QA Status] = "PASS", 1, 0 ) )
		formatString: 0
		displayFolder: QA
		lineageTag: db2ed6e9-daf8-43d7-97c8-404cba56c16f

	measure 'QA Total Count' = COUNTROWS ( qa_expected )
		formatString: 0
		displayFolder: QA
		lineageTag: b160d5d8-abd2-4722-9af5-820d4451f78c

	column _
		dataType: string
		lineageTag: 02debf0e-c284-45a1-8471-e9fbca0846db
		summarizeBy: none
		sourceColumn: _

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
					Source = Table.FromRows({}, type table [#"_" = text])
				in
					Source

