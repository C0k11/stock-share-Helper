	measure 'Latest Yes Price' =
			VAR d = CALCULATE ( MAX ( fact_event_odds[as_of] ), ALLSELECTED ( dim_date ) )
			RETURN CALCULATE ( AVERAGE ( fact_event_odds[yes_price] ),
			                   REMOVEFILTERS ( dim_date ), fact_event_odds[as_of] = d )
		formatString: 0.00%;-0.00%;0.00%
