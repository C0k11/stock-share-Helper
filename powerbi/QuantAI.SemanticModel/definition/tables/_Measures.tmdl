	measure 'Market Value' =
			VAR d = [Latest As Of]
			RETURN CALCULATE ( SUM ( fact_positions[market_value] ), REMOVEFILTERS ( dim_date ),
			            fact_positions[as_of] = d )
		formatString: #,0.00
