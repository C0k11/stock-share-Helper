.env
.env.local
*.env
.env.*
*.pem
*.key
secrets.yaml

# 本地配置覆盖（人设/密钥/本机路径，不提交）
*.local.yaml

# ====================
# 系统文件
# ====================
.DS_Store
Thumbs.db
desktop.ini

# ====================
# 临时文件
# ====================
tmp/
temp/
*.tmp
*.bak

/scripts/eval_outputs/
/scripts/eval_results/

